# Copy to deploy/.env (or run `make env`, which fills in the secrets).

# Pick one DATABASE_URL.
# Local container (docker compose --profile local-db):
DATABASE_URL=postgres://upsera:change-me@postgres:5432/upsera?sslmode=disable
POSTGRES_PASSWORD=change-me
# Supabase (session pooler, port 5432, IPv4 friendly):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# >= 32 chars; back it up with the database (it encrypts channel secrets).
# Generate with: openssl rand -base64 32
APP_SECRET=

BASE_URL=http://localhost:3080
TZ=UTC
LOG_LEVEL=info
LOG_FORMAT=json
HEARTBEAT_RETENTION_DAYS=14
DB_MAX_CONNS=10
HEARTBEAT_BUFFER_SIZE=100000
